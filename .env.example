# --- Base de datos (PostgreSQL) ---
# Postgres gratuito en https://neon.tech o https://supabase.com
DATABASE_URL="postgresql://usuario:password@host/db?sslmode=require"
DIRECT_URL="postgresql://usuario:password@host/db?sslmode=require"

# Secreto para firmar los tokens de sesión (JWT). Cambiar en producción.
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Token para el endpoint /api/seed (sembrar datos una vez tras desplegar).
SEED_TOKEN="pon-un-token-secreto-aqui"

# --- Mercado Pago ---
MP_MOCK="true"
MP_ACCESS_TOKEN=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Google Analytics (opcional) ---
NEXT_PUBLIC_GA_ID=""

# --- Subida de imágenes (Vercel Blob) ---
# Se crea automáticamente al conectar un store de Blob al proyecto en Vercel.
# Para desarrollo local, cópialo desde el dashboard de Vercel.
BLOB_READ_WRITE_TOKEN=""
